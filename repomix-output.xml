  font-size: 0.9rem;
}

/* Input and Select base styles */
.form-group select,
.form-group input {
  width: 100%;
  min-width: 0; /* Prevents overflow issues */
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
  padding: 0.8rem 1rem;
  border-radius: 12px;
  font-size: 1rem;
  transition: all 0.3s ease;
