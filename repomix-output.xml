  --text-inverse: #0f172a;

  /* Borders */
  --border-color: rgba(148, 163, 184, 0.15);
  --border-focus: var(--primary);

  /* Radius */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
